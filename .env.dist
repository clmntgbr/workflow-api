PORT=3000
GO_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400
RATE_LIMIT_MAX=100

###> postgres ###
POSTGRES_VERSION=16
POSTGRES_DB=db
POSTGRES_USER=random
POSTGRES_PASSWORD=random
POSTGRES_NAME=database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_NAME}:5432/${POSTGRES_DB}?sslmode=disable
###< postgres ###

###> ngrok/ngrok ###
NGROK_AUTHTOKEN=
###< ngrok/ngrok ###

###> clerk/clerk-go ###
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
###< clerk/clerk-go ###

###> rabbitmq ###
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@broker:5672/
RABBITMQ_EXCHANGE=domain.events
RABBITMQ_QUEUE=domain.events
RABBITMQ_ROUTING_KEY=#
RABBITMQ_RETRY_TTL_MS=30000
WORKER_MAX_RETRIES=3
OUTBOX_POLL_INTERVAL=2s
WORKER_CONCURRENCY=4
RABBITMQ_EXECUTOR_EXCHANGE=step_run.execute
RABBITMQ_EXECUTOR_QUEUE=step_run.execute
RABBITMQ_EXECUTOR_ROUTING_KEY=step_run.execute
SCHEDULER_INTERVAL=1m
SCHEDULER_BATCH_SIZE=100
SCHEDULER_CONCURRENCY=32
SCHEDULER_MAX_BATCHES_PER_TICK=100
STEP_RUN_WAITING_POLL_INTERVAL=1s
STEP_RUN_WAITING_POLL_BATCH_SIZE=100
###< rabbitmq ###

###> centrifugo/centrifugo ###
CENTRIFUGO_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:3001
CENTRIFUGO_PUBLIC_WS_URL=ws://localhost:8000/connection/websocket
###< centrifugo/centrifugo ###

###> stripe/stripe-go ###
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIRECT_SUCCESS_URL=http://localhost:3000/subscription/success
REDIRECT_CANCEL_URL=http://localhost:3000/subscription/failed
REDIRECT_PORTAL_URL=http://localhost:3000/subscription
###< stripe/stripe-go ###
